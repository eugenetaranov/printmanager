#!/bin/sh
# Idempotently (re)create the CUPS queue for a USB-attached Brother printer.
# Detects the device URI via `lpinfo -v`; when the printer is not connected it
# leaves any existing queue untouched and exits 0 so provisioning still passes.
#
# Env (set by the Tack task):
#   QUEUE       queue name           (e.g. DCP1511)
#   PPD         brlaser PPD/model    (e.g. drv:///brlaser.drv/br1510.ppd)
#   DESC        printer-info string
#   LOCATION    printer-location string
#   SET_DEFAULT "true" to set as system default
set -eu

uri="$(lpinfo -v 2>/dev/null | awk '/usb:\/\/Brother/ {print $2; exit}')"

if [ -z "$uri" ]; then
  echo "No Brother USB printer detected; leaving queue '$QUEUE' unchanged."
  echo "Re-run after connecting the DCP-1511 to finalize the queue."
  exit 0
fi

echo "Detected Brother at $uri; configuring queue '$QUEUE'."
lpadmin -p "$QUEUE" -E -v "$uri" -m "$PPD" \
  -o printer-is-shared=true \
  -D "$DESC" -L "$LOCATION"

cupsenable "$QUEUE"
cupsaccept "$QUEUE"

if [ "${SET_DEFAULT:-false}" = "true" ]; then
  lpadmin -d "$QUEUE"
fi
