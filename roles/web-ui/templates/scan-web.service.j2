# Managed by Tack — roles/scan-server.
[Unit]
Description=Scan-to-share web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ .scan_web_user }}
Group={{ .scan_group }}
# All config is read from this YAML file (rendered by the role), keeping the
# Python a plain .py file with no templating.
Environment=SCAN_WEB_CONFIG=/usr/local/lib/scan-web/config.yaml
# Run from the venv interpreter (created with --system-site-packages, so the apt
# reportlab/Pillow are still importable) so `bleak` on the Niimbot path resolves.
ExecStart={{ .niimbot_venv }}/bin/python3 /usr/local/lib/scan-web/scan-web.py
Restart=on-failure
RestartSec=3
# Allow binding a privileged port (e.g. 80) as the non-root scans user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
