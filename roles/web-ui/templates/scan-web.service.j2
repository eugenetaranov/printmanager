# Managed by Tack — roles/scan-server.
[Unit]
Description=Scan-to-share web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ .scan_web_user }}
Group={{ .scan_group }}
Environment=SCAN_WEB_DIR={{ .scan_dir }}
Environment=SCAN_WEB_PORT={{ .scan_web_port }}
Environment=SCAN_WEB_TITLE={{ .scan_web_title }}
Environment=SCAN_WEB_SHARE={{ .scan_web_share }}
Environment=SCAN_WEB_SCRIPT=/usr/local/lib/scan-web/scan-to-share.sh
Environment=SCAN_WEB_DEFAULT_MODE={{ .scan_web_default_mode }}
Environment=SCAN_WEB_DEFAULT_RES={{ .scan_web_default_res }}
Environment=SCAN_WEB_PRINT_ENABLED={{ .scan_web_print_enabled }}
Environment=SCAN_WEB_PRINT_QUEUE={{ .scan_web_print_queue }}
ExecStart=/usr/bin/python3 /usr/local/lib/scan-web/scan-web.py
Restart=on-failure
RestartSec=3
# Allow binding a privileged port (e.g. 80) as the non-root scans user.
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
