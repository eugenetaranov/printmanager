  .progress .bar{width:100%;transform:none}
}
</style>
</head>
<body>
<div class="wrap">
  <header class="top">
    <div class="brand">Scan<small>__TITLE__ · flatbed</small></div>
    <span class="status" id="status" data-state="idle" role="status" aria-live="polite">
      <i class="led"></i><span id="statusText">Ready</span>
    </span>
  </header>

  <form class="card" id="form">
    <div class="controls">
      <label class="field"><span class="lbl">Mode</span>
        <select name="mode" id="mode">__MODE_OPTS__</select></label>
      <label class="field"><span class="lbl">Resolution</span>
        <select name="resolution" id="resolution">__RES_OPTS__</select></label>
    </div>
    <button class="scan" id="scanBtn" type="submit">Scan</button>
    <div class="progress" aria-hidden="true"><div class="bar"></div></div>
    <p class="note" id="note" aria-live="polite"></p>
  </form>

  <section class="recent">
    <h2>Recent scans</h2>
    <div class="path">Saved to __SHARE__</div>
    <ul class="list" id="list">
      <li class="empty">No scans yet. Place a page on the glass and press Scan.</li>
    </ul>
  </section>
</div>

<script>
(function(){
  var form=document.getElementById('form');
  var btn=document.getElementById('scanBtn');
  var status=document.getElementById('status');
  var statusText=document.getElementById('statusText');
  var note=document.getElementById('note');
  var list=document.getElementById('list');
  var scanning=false, firstLoad=null;

  function fmtSize(b){
    if(b<1024) return b+' B';
    if(b<1048576) return (b/1024).toFixed(b<10240?1:0)+' KB';
    return (b/1048576).toFixed(1)+' MB';
  }
  function ago(sec){
    var d=Math.max(0,Math.floor(Date.now()/1000)-sec);
    if(d<60) return 'just now';
    if(d<3600) return Math.floor(d/60)+'m ago';
    if(d<86400) return Math.floor(d/3600)+'h ago';
    return Math.floor(d/86400)+'d ago';
  }
  function render(scans, newest){
    if(!scans.length){
      list.innerHTML='<li class="empty">No scans yet. Place a page on the glass and press Scan.</li>';
      return;
    }
    list.innerHTML='';
    scans.forEach(function(s){
      var li=document.createElement('li');
      li.className='row'+(s.name===newest?' new':'');
      var a='/file/'+encodeURIComponent(s.name);
      li.innerHTML='<span class="name" title="'+s.name+'">'+s.name+'</span>'+
        '<span class="size">'+fmtSize(s.size)+'</span>'+
        '<span class="ago">'+ago(s.mtime)+'</span>'+
        '<a class="dl" href="'+a+'" target="_blank" rel="noopener" title="Open" aria-label="Open '+s.name+'">'+
        '<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v8M5 7l3 3 3-3M3 13h10"/></svg></a>';
      list.appendChild(li);
    });
  }
  function refresh(newest){
    return fetch('/recent').then(function(r){return r.json();})
      .then(function(d){render(d.scans||[], newest);})
      .catch(function(){});
  }
  function setStatus(state,text){ status.dataset.state=state; statusText.textContent=text; }

  form.addEventListener('submit',function(e){
    e.preventDefault();
    if(scanning) return;
    scanning=true;
    form.classList.add('scanning');
    btn.disabled=true; btn.textContent='Scanning…';
    note.className='note'; note.textContent='';
    setStatus('busy','Scanning');
    var body=new URLSearchParams(new FormData(form)).toString();
    fetch('/scan',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
      .then(function(r){return r.json();})
      .then(function(d){
        if(d.ok){
          setStatus('idle','Ready');
          note.className='note ok';
          note.innerHTML='Saved '+d.file+' · '+d.seconds+'s — <a href="/file/'+encodeURIComponent(d.file)+'" target="_blank" rel="noopener">open</a>';
          return refresh(d.file);
        }
        setStatus('error','Failed');
        note.className='note err'; note.textContent=d.error||'Scan failed.';
      })
      .catch(function(){
        setStatus('error','Failed');
        note.className='note err'; note.textContent='Could not reach the scanner service.';
      })
      .finally(function(){
        scanning=false; form.classList.remove('scanning');
        btn.disabled=false; btn.textContent='Scan';
      });
  });

  refresh();
  setInterval(function(){ if(!scanning) refresh(); }, 15000);
})();
</script>
</body>
</html>"""


if __name__ == "__main__":
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
