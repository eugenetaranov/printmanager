#!/bin/bash
# Scan one page via Brother's official brscan4 driver running in the i386 chroot,
# and write a compressed PDF into the scan share; echo its path. Runs as root
# (scan-web sudo's this — see /etc/sudoers.d/brscan). The whole pipeline is here
# so there are no cross-user permission seams.
#
# Usage: brscan-scan.sh MODE RES QUALITY [NAME]
set -e
CHROOT='{{ .brscan4_chroot }}'
DEST='{{ .scan_dir }}'
GROUP='{{ .scan_group }}'
MODE="$1"; RES="$2"; QUALITY="${3:-{{ .scan_jpeg_quality }}}"

# Optional filename. Sanitize hard (this is a NOPASSWD sudo arg): keep only safe
# characters, collapse spaces to dashes — no slashes/dots, so no path traversal.
NAME="$(printf '%s' "${4:-}" | tr -cd 'A-Za-z0-9 _-' | sed 's/  */ /g; s/^ *//; s/ *$//; s/ /-/g')"

# Validate inputs (these reach scanimage/convert; keep them to known values).
case "$MODE" in "24bit Color"|"True Gray"|"Black & White"|"Gray[Error Diffusion]") ;; *) MODE="{{ .scan_mode }}";; esac
case "$RES"  in 100|150|200|300|400|600) ;; *) RES="{{ .scan_resolution }}";; esac
case "$QUALITY" in ''|*[!0-9]*) QUALITY="{{ .scan_jpeg_quality }}";; esac

# Make sure USB is visible inside the chroot.
for m in dev proc sys; do
  mountpoint -q "$CHROOT/$m" || mount --bind "/$m" "$CHROOT/$m"
done

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Scan to raw PNM (no strip metadata to corrupt). Brother's driver truncates the
# last row or two at higher DPI, so pad the raw data back to full size.
cin="/tmp/brscan-$$.pnm"
chroot "$CHROOT" scanimage --mode "$MODE" --resolution "$RES" --format=pnm -o "$cin"
cp "$CHROOT$cin" "$work/p.pnm"
rm -f "$CHROOT$cin"
python3 /usr/local/lib/scan-web/pad_pnm.py "$work/p.pnm"

# -sampling-factor 1x1 (no chroma subsampling) + high quality keeps text edges
# crisp; without it, q80 chroma subsampling produces a diagonal sawtooth.
convert "$work/p.pnm" -sampling-factor 1x1 -quality "$QUALITY" "$work/p.jpg"

if [ -n "$NAME" ]; then base="$DEST/$NAME"; else base="$DEST/scan-$(date +%Y%m%d-%H%M%S)"; fi
out="$base.pdf"
[ -e "$out" ] && out="$base-$(date +%H%M%S).pdf"   # don't clobber an existing name
img2pdf "$work/p.jpg" -o "$out"
chgrp "$GROUP" "$out" 2>/dev/null || true
chmod 0660 "$out" 2>/dev/null || true
echo "$out"
