#!/bin/sh
# Scan via Brother's driver (root chroot helper) and drop a compressed PDF into
# the Samba scan share. Invoked by scan-web (as the scans user) and usable by
# hand. Output settings come from the environment (scan-web sets them) or the
# role defaults baked into the helper.
set -eu
sudo /usr/local/sbin/brscan-scan.sh \
  "${SCAN_MODE:-{{ .scan_mode }}}" \
  "${SCAN_RES:-{{ .scan_resolution }}}" \
  "${SCAN_QUALITY:-{{ .scan_jpeg_quality }}}"
