#!/bin/sh
# Scan via Brother's driver and write a compressed PDF into the Samba scan share.
# Runs as the scans user (scan-web) — no privilege needed: it scans over the
# localhost saned net bridge (host SANE dll.conf = net -> chroot saned ->
# brscan4), and the scans user owns the share directory. (Scanning in the chroot
# directly via -o truncates at high DPI; the net path delivers full data.)
set -eu
DEST='{{ .scan_dir }}'
RES="${SCAN_RES:-{{ .scan_resolution }}}"
MODE="${SCAN_MODE:-{{ if .scan_escl_enabled }}{{ .scan_escl_mode }}{{ else }}{{ .scan_mode }}{{ end }}}"
QUALITY="${SCAN_QUALITY:-{{ .scan_jpeg_quality }}}"

# Optional filename; keep only safe chars, spaces -> dashes (no slashes/dots, so
# no path traversal).
NAME="$(printf '%s' "${SCAN_NAME:-}" | tr -cd 'A-Za-z0-9 _-' | sed 's/  */ /g; s/^ *//; s/ *$//; s/ /-/g')"

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

# Scan to raw PNM. On the brscan4 net path pad to full size (Brother short-reads
# ~1 row); the eSCL backend delivers full data, so no padding.
scanimage --mode "$MODE" --resolution "$RES" --format=pnm > "$tmp/p.pnm"
{{ if not .scan_escl_enabled }}python3 /usr/local/lib/scan-web/pad_pnm.py "$tmp/p.pnm"
{{ end -}}
# -sampling-factor 1x1 (no chroma subsampling) keeps text edges crisp.
convert "$tmp/p.pnm" -sampling-factor 1x1 -quality "$QUALITY" "$tmp/p.jpg"

if [ -n "$NAME" ]; then base="$DEST/$NAME"; else base="$DEST/scan-$(date +%Y%m%d-%H%M%S)"; fi
out="$base.pdf"
[ -e "$out" ] && out="$base-$(date +%H%M%S).pdf"   # don't clobber an existing name
img2pdf "$tmp/p.jpg" -o "$tmp/img.pdf"
if [ '{{ .scan_ocr_enabled }}' = 'true' ] && command -v ocrmypdf >/dev/null 2>&1; then
  # Add a searchable (invisible) OCR text layer; fall back to the image-only PDF
  # on any failure (e.g. a blank page). --optimize 0 leaves our JPEG untouched.
  ocrmypdf -l '{{ range $i, $l := .scan_ocr_langs }}{{ if $i }}+{{ end }}{{ $l }}{{ end }}' --output-type pdf --optimize 0 --quiet \
    "$tmp/img.pdf" "$out" 2>"$tmp/ocr.log" || cp "$tmp/img.pdf" "$out"
else
  cp "$tmp/img.pdf" "$out"
fi
chmod 0660 "$out" 2>/dev/null || true

# Sidecar thumbnail + metadata (DPI/mode) for the web UI, kept out of the share.
b="$(basename "$out" .pdf)"
mkdir -p /var/lib/scan-web/thumbs /var/lib/scan-web/meta 2>/dev/null || true
convert "$tmp/p.jpg" -resize 480x -quality 70 "/var/lib/scan-web/thumbs/$b.jpg" 2>/dev/null || true
printf '%s\t%s\n' "$RES" "$MODE" > "/var/lib/scan-web/meta/$b" 2>/dev/null || true

echo "$out"
